/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self' https://api.stripe.com https://api.brevo.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

# UTF-8 tipleri (mojibake'ı önler)
/app.js
  Content-Type: application/javascript; charset=utf-8
/content/*
  Content-Type: application/json; charset=utf-8

# Sadece /admin için (Decap CMS)
/admin*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net; connect-src 'self' https://api.github.com; img-src 'self' data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'; upgrade-insecure-requests
